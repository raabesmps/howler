# Settings for the server. Copy this to /opt/howler/.env ON THE SERVER and fill it in. That file is never committed:
# the real values (the app key, the database password, the OpenAI key) exist only there.
# `chmod 600 .env` so only its owner can read it.

# ---- the site
APP_NAME=Howler
APP_ENV=production
APP_DEBUG=false
# the public address, with https (used in links and in the link-preview tags built into the page)
APP_URL=https://howler.example.com
# the domain Caddy serves and gets a certificate for. For a first test without a domain: 203-0-113-10.sslip.io
SITE_ADDRESS=howler.example.com

# ---- secrets
# generate once:  docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show
APP_KEY=
# a long random password: openssl rand -base64 32 | tr -d '/+='
DB_PASSWORD=
# the voice (ADR-002). Server side only. Without it howlers are created without a server voice.
OPENAI_API_KEY=
# at most this many server voices per day, for everybody: a safety net for the OpenAI bill
HOWLER_VOICE_DAILY_LIMIT=300

# ---- database (the db container of docker-compose.prod.yml)
DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=howler
DB_USERNAME=howler

# ---- laravel
LOG_CHANNEL=stderr
LOG_LEVEL=warning
CACHE_STORE=database
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
# Caddy hands PHP the real client address (FastCGI), so no proxy needs to be trusted: leave this empty
TRUSTED_PROXIES=

# ---- error monitoring (optional, see docs/guides/DEPLOYMENT.md). Empty means off.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=staging
